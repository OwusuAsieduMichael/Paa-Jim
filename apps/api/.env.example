# Copy to .env for local dev. In staging/production these live in Railway, never in git.
NODE_ENV=development
PORT=3000

# `npx supabase status` prints these for the local stack
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Paystack dashboard → Settings → API Keys & Webhooks (TEST mode for local/staging)
PAYSTACK_SECRET_KEY=sk_test_
PAYSTACK_WEBHOOK_IPS=52.31.139.75,52.49.173.169,52.214.14.220

# Optional locally: without it jobs run in-process
REDIS_URL=

# Firebase console → Project settings → Service accounts → Generate key (paste JSON on one line)
FCM_SERVICE_ACCOUNT_JSON=

# SMS: 'log' prints instead of sending. 'arkesel' needs SMS_API_KEY.
SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER_ID=PaaJim
KITCHEN_ALERT_PHONE=
SEND_SMS_HOOK_SECRET=

SENTRY_DSN=
AUTO_CANCEL_MINUTES=8
VENDOR_ALERT_ESCALATE_MINUTES=5
RECONCILE_AFTER_SECONDS=90
