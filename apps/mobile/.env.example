# Copy to apps/mobile/.env. EVERYTHING here ships inside the app — never put a secret here.
# Leave the Supabase values empty to run in DEMO mode (in-memory backend, any OTP works).

# `npx supabase status` → API URL / anon key (local), or the hosted project's values
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Node API. On a physical phone use your PC's LAN IP (e.g. http://192.168.1.20:3000), not localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000

# Google Cloud → restricted keys (Android: package name + SHA-1 from `eas credentials`; iOS: bundle ID)
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=

# Force demo mode even with Supabase configured
EXPO_PUBLIC_DEMO=
